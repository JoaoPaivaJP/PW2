function calcularmedia(n1,n2,n3,n4){
     const media = (n1+n2+n3+n4) / 4; 
    return media;
} 

const n1 = 67;
const n2 = 67;
const n3 = 67;
const n4 = 67;

const mediaFinal = calcularmedia(n1, n2, n3, n4);

console.log(`A média final é: ${mediaFinal}`);

