mediaFinal.js:

/* App para calcular a média do aluno, iformando sse foi aprovato ou reprovado */

const nome = "Ana Heloisa";
const curso = "DS";

function calcularmedia (n1, n2, n3, n4){
    const media = (n1+n2+n3+n4) / 4
    return media;
}

const n1 = 5;
const n2 = 2;
const n3 = 7;
const n4 = 10;

const mediaFinal = calcularmedia(n1,n2,n3,n4);

let situacao;

if(mediaFinal >= 6) {
   situacao = "Aprovado!";
}else{
 situacao = "Reprovado.";
}

console.log(`Aluno: ${nome}`);
console.log(`Curso: ${curso}`);
console.log(`Situação: ${situacao}`);
console.log(`Média final: ${mediaFinal}`);

receberDados.js

import readline from "node:readline";
const entrada = readline.createinterface({
    input: ProcessingInstruction.stdin,
    output:ProcessingInstruction.stdout
});

entrada.question("Digite um número: ", function(valorDigitado) {
    const numero = Number(valorDigitado);
    const dobro = numero * 2;

    console.log(`Dobro de ${numero} é ${dobro}.`);

});
