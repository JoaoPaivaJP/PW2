const readline = require("node:readline/promises");
const { stdin, stdout } = require("node:process");

const entrada = readline.createInterface({
  input: stdin,
  output: stdout
});

function calcularMedia(notas) {
    let soma = 0;

    for (let i = 0; i < notas.length; i++) {
        soma = soma + notas[i];
    }

    return soma / notas.length;
}

async function iniciarPrograma() {
    const nome = await entrada.question("Digite o nome do aluno: ");
    const curso = await entrada.question("Digite o curso: ");

    const notas = [];

    for (let i = 1; i <= 4; i++) {
        const notaDigitada = await entrada.question (`Digite a ${i}ª nota: `
        );

        const nota = Number(notaDigitada);
        notas.push(nota);
    }

    const mediaFinal = calcularMedia(notas);

    let situacao;

    if (mediaFinal >= 0) {
        situacao = "Aprovado"
    } else {
        situacao = "Reprovado"
    }

    console.log("\n--- Resultado do aluno ---");
    console.log(`Aluno: ${nome}`);
    console.log(`Curso: ${curso}`);
    console.log(`Notas: ${notas.join(", ")}`);
    console.log(`Média final: ${mediaFinal.toFixed(2)}`);
    console.log(`Situição: ${situacao}`);

    entrada.close();
}

iniciarPrograma();
