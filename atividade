//iniciar o Banco de dados virtual
function iniciarBanco(){
    let usuarioSalvo = localStorage.getItem("usuario");

    if(usuarioSalvo === null) {
        "usuario", JSON.stringify(usuarioInicial);
    }
}

//Função recebe os dados de autenticar usuario
function autenticar(login, senha) {
    let dados = localStorage.getItem("usuario");
    if (dados === null) {
        return {
            sucesso: false,
            mensagem: "Usuário não encontrado"
        };
    }

    let usuario = JSON.parse(dados);

    if (login === usuario.login && senha === usuario.senha) {
        return {
            sucesso: true, 
            mensagem: "Login realizado com sucesso",
            usuario: usuario
        }
    }

    return {
        sucesso: false,
        mensagem: "Usuário ou senha inválidos"
    }
}
iniciarBanco();
